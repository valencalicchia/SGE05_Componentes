<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del formulario del wizard -->
    <record id="view_contact_import_wizard" model="ir.ui.view">
        <field name="name">contact.import.wizard.form</field>
        <field name="model">contact.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Contactos desde CSV">
                <sheet>
                    <group>
                        <field name="file"/>
                    </group>
                    <footer>
                        <button name="import_contacts" type="object" string="Importar" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard -->
    <record id="action_contact_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Contactos</field>
        <field name="res_model">contact.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Ítem del menú dentro de Contactos -->
    <menuitem id="menu_contact_import_wizard"
              name="Importar Contactos"
              action="action_contact_import_wizard"
              parent="contacts.menu_contacts"/>
</odoo>
