<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="import_clientes_form" model="ir.ui.view">
        <field name="name">import.clientes.form</field>
        <field name="model">import.clientes</field>
        <field name="arch" type="xml">
            <form string="Importar Clientes">
                <sheet>
                    <group>
                        <field name="archivo_csv"/>
                    </group>
                    <footer>
                        <button name="importar_clientes" type="object" string="Importar" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_import_clientes" model="ir.actions.act_window">
        <field name="name">Importar Clientes</field>
        <field name="res_model">import.clientes</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_import_clientes" name="Importar Clientes" 
              action="action_import_clientes" parent="contacts.menu_contacts"/>
</odoo>